{
  "name": "crowdreply-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3001",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@cloudlet/toast": "1.2.0",
    "@tailwindcss/postcss": "4.3.4",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@>=4": "11.0.4",
    "eslint": {
      "minimatch": "file:../../tools/minimatch-compat"
    },
    "eslint-plugin-react": {
      "minimatch": "file:../../tools/minimatch-compat"
    },
    "eslint-plugin-import": {
      "minimatch": "file:../../tools/minimatch-compat"
    },
    "eslint-plugin-jsx-a11y": {
      "minimatch": "file:../../tools/minimatch-compat"
    },
    "@eslint/config-array": {
      "minimatch": "file:../../../tools/minimatch-compat"
    },
    "@eslint/eslintrc": {
      "minimatch": "file:../../../tools/minimatch-compat"
    }
  }
}
