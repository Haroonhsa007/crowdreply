# API keys (optional provider keys; absent keys select Mock)
OPERATOR_API_KEY=change-me-operator-api-key
# OPENAI_API_KEY=change-me-provider-key
# PERPLEXITY_API_KEY=change-me-provider-key
# GEMINI_API_KEY=change-me-provider-key
# ANTHROPIC_API_KEY=change-me-provider-key

# Operator login and server-side key encryption
OPERATOR_USERNAME=change-me-operator
OPERATOR_PASSWORD=change-me-operator-password
SESSION_SECRET=change-me-session-secret-at-least-32-characters
KEY_ENCRYPTION_SECRET=change-me-encryption-secret-at-least-32-characters
USER_KEY_TTL_SECONDS=3600

# Database credentials (replace matching placeholders in the URLs too)
MONGO_ROOT_USERNAME=change-me-root-user
MONGO_ROOT_PASSWORD=change-me-mongo-password
REDIS_PASSWORD=change-me-redis-password
MONGODB_URI=mongodb://change-me-root-user:change-me-mongo-password@127.0.0.1:27017/crowdreply?authSource=admin
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379

# Runtime settings
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SPEND_CAP_USD=2
LOG_LEVEL=info
OPENAI_MODEL=gpt-6-luna
PERPLEXITY_MODEL=perplexity/sonar
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
# Research has conflicting version guidance; verify before paid use.
ANTHROPIC_VERSION=2023-06-01
PROVIDER_TIMEOUT_MS=60000
MAX_ATTEMPTS=4
RETRY_BASE_MS=2000
RETRY_MAX_MS=60000
WORKER_CONCURRENCY=1
LIVE_CALL_RESERVE_USD=0.05
API_BASE_URL=http://127.0.0.1:3000

# Container-only URI forms; percent-encode credentials when replacing placeholders.
DOCKER_MONGODB_URI=mongodb://change-me-root-user:change-me-mongo-password@mongo:27017/crowdreply?authSource=admin
DOCKER_REDIS_URL=redis://:change-me-redis-password@redis:6379

# Production config validation placeholders only; choose your approved real release.
IMAGE_NAMESPACE=example/crowdreply
IMAGE_TAG=v0.1.0
